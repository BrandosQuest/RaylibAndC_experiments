{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build debug",
            "type": "process",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": ["UpdateMake"]
        },
        {
            "label": "build debug no premake",
            "type": "process",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build release",
            "type": "process",
            "command": "make",
            "args": [
                "config=release_x64"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": ["UpdateMake"]
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "make",
            "args": [
                "clean"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": ["UpdateMake"]
        },
        {
            "label": "UpdateMake",
            "type": "process",
            "command": "./premake5",
            "options": {
                "cwd": "${workspaceFolder}/build/"
            },
            "args": [
                "gmake"
            ],
            "group": "build",
            "dependsOn": ["Generate compile_commands.json"]
        },
        {
            "label": "Generate compile_commands.json",
            "type": "process",
            "command": "./premake5",
            "options": {
                "cwd": "${workspaceFolder}/build/"
            },
            "args": [
                "ecc"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
